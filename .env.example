# Copie para .env e ajuste os valores.
# A chave da OpenAI NÃO fica aqui: cada usuário cadastra a sua em Meu perfil → Chave OpenAI.

# Obrigatória fora do modo DEBUG. Também criptografa as chaves OpenAI salvas no banco:
# se for trocada, os usuários precisarão cadastrar suas chaves novamente.
# Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave

# True apenas em desenvolvimento
DEBUG=True

# Hosts aceitos, separados por vírgula
ALLOWED_HOSTS=127.0.0.1,localhost

# Origens confiáveis para CSRF (necessário atrás de proxy/HTTPS), ex.: https://financas.seudominio.com
# CSRF_TRUSTED_ORIGINS=

# Banco de dados. Padrão: SQLite local (db.sqlite3). Exemplo PostgreSQL:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/financepro

# ── Produção (opcionais) ──────────────────────────────────────────────────
# SECURE_COOKIES=True          # cookies só via HTTPS (padrão quando DEBUG=False)
# SECURE_SSL_REDIRECT=False    # redireciona HTTP → HTTPS
# SECURE_HSTS_SECONDS=0        # ex.: 31536000 depois de validar o HTTPS
# SERVE_MEDIA=True             # Django serve as fotos de perfil (desative se o Nginx servir /media)
# LOG_LEVEL=INFO
# GUNICORN_WORKERS=3

# ── Docker: superusuário criado na primeira execução (opcional) ───────────
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=
# POSTGRES_PASSWORD=financepro
